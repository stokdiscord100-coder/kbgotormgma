local CACHE_TTL = 45
local _fnCache, _fnCacheTime = {}, {}
local _uvCache, _uvCacheTime = {}, {}

local function cacheGet(t, tt, k)
    if t[k] and (_clock() - (tt[k] or 0)) < CACHE_TTL then return t[k] end
    t[k] = nil; return nil
end

local function cacheSet(t, tt, k, v) t[k] = v; tt[k] = _clock() end

-- ===== FILTERGC =====
if not _filtergc then
    _filtergc = function(ftype, filters, returnSingle)
        filters = filters or {}
        local results = {}
        local gcList = _getgc(true)
        local n = #gcList
        if n == 0 then return returnSingle and nil or results end
        local startIdx = Entropy.int(1, n)
        for i = 0, n - 1 do
            local idx = ((startIdx - 1 + i) % n) + 1
            local obj = gcList[idx]
            if _type(obj) == ftype then
                local ok, info = _pcall(_debug.getinfo, obj)
                if ok and info then
                    local match = true
                    if filters.StartLine and info.linedefined ~= filters.StartLine then match = false end
                    if filters.Source and info.source ~= filters.Source then match = false end
                    if filters.Name and info.name ~= filters.Name then match = false end
                    if filters.NameContains and not (info.name or ""):find(filters.NameContains, 1, true) then match = false end
                    if match then
                        if returnSingle then return obj end
                        results[#results + 1] = obj
                    end
                end
            end
        end
        if returnSingle then return nil end
        return results
    end
    filtergc = _filtergc
end

-- ===== SAFE HOOK =====
local _hookedFns = setmetatable({}, { __mode = "k" })

local function safeHook(fn, replacement)
    if not fn or _type(fn) ~= "function" then return false end
    if _hookedFns[fn] then return true end
    local wrapped = (_newcc and _newcc(replacement)) or replacement
    local ok = _pcall(_hookfn, fn, wrapped)
    if ok then _hookedFns[fn] = true; return true end
    return false
end

-- ===== UPVALUE SCANNER =====
local function scanUpvalues(fn, wantType, stopOnFirst)
    if _type(fn) ~= "function" then return {} end
    local found, nilStreak = {}, 0
    for i = 1, 128 do
        local ok, name, val = _pcall(function() return _debug.getupvalue(fn, i) end)
        if not ok then break end
        if val == nil then
            nilStreak = nilStreak + 1
            if nilStreak >= 6 then break end
        else
            nilStreak = 0
            if not wantType or _type(val) == wantType then
                found[#found + 1] = { index = i, name = name, value = val }
                if stopOnFirst then return found end
            end
        end
    end
    return found
end

-- ===== DEEP FIND =====
local function jWaitLocal(base, variance)
    variance = variance or base * 0.4
    local u = 2 * Entropy.next() - 1
    local t = base + u * u * u * variance
    if t < 0.015 then t = 0.015 end
    if t > 0.6 then t = 0.6 end
    _task.wait(t)
end

local function deepFind(name, lineNumber, upvalueIndex, retries)
    retries = retries or 6
    local cached = cacheGet(_fnCache, _fnCacheTime, name)
    if cached then
        if upvalueIndex then
            local ck = name .. "_uv_" .. _tostring(upvalueIndex)
            return cached, cacheGet(_uvCache, _uvCacheTime, ck)
        end
        return cached
    end

    local fn = nil
    for attempt = 1, retries do
        if attempt > 1 then jWaitLocal(0.03 + 0.02 * attempt, 0.015) end
        local ok, result = _pcall(_filtergc, "function", { StartLine = lineNumber }, true)
        if ok and _type(result) == "function" then
            local iok, info = _pcall(_debug.getinfo, result)
            if iok and info and (not lineNumber or info.linedefined == lineNumber) then fn = result; break end
        end
    end

    if not fn and lineNumber then
        local ok, all = _pcall(_filtergc, "function", { StartLine = lineNumber })
        if ok and _type(all) == "table" then
            for i = #all, 2, -1 do
                local j = Entropy.int(1, i)
                all[i], all[j] = all[j], all[i]
            end
            for _, o in _ipairs(all) do if _type(o) == "function" then fn = o; break end end
        end
    end

    if not fn and name then
        local ok, result = _pcall(_filtergc, "function", { Name = name }, true)
        if ok and _type(result) == "function" then fn = result end
    end

    if not fn and name then
        local prefix = name:sub(1, _min(8, #name))
        local ok, all = _pcall(_filtergc, "function", { NameContains = prefix })
        if ok and _type(all) == "table" then
            for _, o in _ipairs(all) do
                if _type(o) == "function" then
                    local iok, info = _pcall(_debug.getinfo, o)
                    if iok and info and info.name == name then fn = o; break end
                end
            end
        end
    end

    if not fn then
        local gcAll = _getgc(true)
        local n = #gcAll
        if n > 0 then
            local CHUNK = 400
            local co = _coroutine.create(function()
                local startOff = Entropy.int(1, n)
                for i = 0, n - 1 do
                    local idx = ((startOff + i - 1) % n) + 1
                    local obj = gcAll[idx]
                    if _type(obj) == "function" then
                        local iok, info = _pcall(_debug.getinfo, obj)
                        if iok and info then
                            if (lineNumber and info.linedefined == lineNumber)
                            or (name and info.name == name) then
                                _coroutine.yield(obj); return
                            end
                        end
                    end
                    if i % CHUNK == 0 then _coroutine.yield(nil) end
                end
                _coroutine.yield(nil)
            end)
            local deadline = _clock() + 4
            local resumes = 0
            while _clock() < deadline and resumes < 512 do
                resumes = resumes + 1
                local ok, result = _coroutine.resume(co)
                if not ok then break end
                if result ~= nil then fn = result; break end
                if _coroutine.status(co) == "dead" then break end
                _task.wait()
            end
        end
    end

    if _type(fn) == "function" then gv[name] = fn; cacheSet(_fnCache, _fnCacheTime, name, fn) end

    if fn and upvalueIndex then
        local ck = name .. "_uv_" .. _tostring(upvalueIndex)
        local uvCached = cacheGet(_uvCache, _uvCacheTime, ck)
        if uvCached then return fn, uvCached end
        local uv = nil
        local ok, val = _pcall(_debug.getupvalue, fn, upvalueIndex)
        if ok and val ~= nil then uv = val
        else
            for _, e in _ipairs(scanUpvalues(fn, nil, false)) do
                if _type(e.value) == "function" or _type(e.value) == "userdata" then uv = e.value; break end
            end
        end
        if uv ~= nil then cacheSet(_uvCache, _uvCacheTime, ck, uv) end
        return fn, uv
    end
    return fn
end

-- ===== FIND HYPHON SCRIPT =====
local _scriptCache, _scriptCacheTime = nil, 0

local function findHyphonScript()
    if _scriptCache and (_clock() - _scriptCacheTime) < CACHE_TTL then return _scriptCache end
    local script = nil
    local sources = {
        function()
            local ok, nilObjs = _pcall(_getnilins)
            if not ok or not nilObjs then return end
            local n = #nilObjs; if n == 0 then return end
            local s = Entropy.int(1, n)
            for i = 0, n - 1 do
                local idx = ((s + i - 1) % n) + 1
                local o = nilObjs[idx]
                local ok2, valid = _pcall(function()
                    return (o:IsA("LocalScript") or o:IsA("Script") or o:IsA("ModuleScript")) and #o.Name == 32
                end)
                if ok2 and valid then script = o; return end
            end
        end,
        function()
            local gcAll = _getgc(false)
            local n = #gcAll
            local CHUNK = 200
            for cs = 1, n, CHUNK do
                for i = cs, _min(cs + CHUNK - 1, n) do
                    local o = gcAll[i]
                    if _type(o) == "userdata" then
                        local ok2, valid = _pcall(function()
                            return (o:IsA("LocalScript") or o:IsA("Script")) and #o.Name == 32
                        end)
                        if ok2 and valid then script = o; return end
                    end
                end
                if script then return end
                _task.wait()
            end
        end,
        function()
            for _, svc in _ipairs({ game:GetService("CoreGui"), game:GetService("Players"), workspace }) do
                _pcall(function()
                    for _, o in _ipairs(svc:GetDescendants()) do
                        local ok2, valid = _pcall(function()
                            return (o:IsA("LocalScript") or o:IsA("Script")) and #o.Name == 32
                        end)
                        if ok2 and valid then script = o; return end
                    end
                end)
                if script then return end
                jWaitLocal(0.04, 0.015)
            end
        end,
    }
    for _, src in _ipairs(sources) do
        _pcall(src)
        if script then break end
        jWaitLocal(0.06, 0.02)
    end
    _scriptCache = script
    _scriptCacheTime = _clock()
    gv.Hyphon_Script = script
    return script
end

