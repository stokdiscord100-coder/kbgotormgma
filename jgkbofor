-- ===== CRASH GUARD =====
local CrashGuard = {
    errorLog = {}, maxLog = 64, errorCount = 0, okCount = 0,
    threshold = 20, throttled = false, registered = {},
    memCap = 200 * 1024 * 1024, lastGC = _clock(),
}

function CrashGuard.wrap(name, fn)
    if _type(fn) ~= "function" then return fn end
    local wrapped = function(...)
        if CrashGuard.throttled and name ~= "critical" then return nil end
        local ok, result = _xpcall(fn, function(err)
            CrashGuard.errorCount = CrashGuard.errorCount + 1
            _insert(CrashGuard.errorLog, { name = name, err = _tostring(err), t = _clock() })
            if #CrashGuard.errorLog > CrashGuard.maxLog then _remove(CrashGuard.errorLog, 1) end
            if CrashGuard.errorCount > CrashGuard.threshold then
                CrashGuard.throttled = true
                _task.delay(2, function()
                    CrashGuard.throttled = false
                    CrashGuard.errorCount = _floor(CrashGuard.errorCount / 2)
                end)
            end
            return err
        end, ...)
        if ok then CrashGuard.okCount = CrashGuard.okCount + 1; return result end
        return nil
    end
    CrashGuard.registered[name] = wrapped
    return wrapped
end

local function memCheck()
    local now = _clock()
    if now - CrashGuard.lastGC < 2 then return true end
    CrashGuard.lastGC = now
    local ok, kb = _pcall(collectgarbage, "count")
    if ok and _type(kb) == "number" then
        if kb * 1024 > CrashGuard.memCap then
            _pcall(collectgarbage, "collect")
            return false
        end
    end
    return true
end

