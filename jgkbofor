-- ===== LINEAGE =====
local Lineage = {}
Lineage.__index = Lineage

function Lineage.new()
    return setmetatable({ generations = {}, maxDepth = 12, epoch = 0, byToken = {}, maxNodes = 96 }, Lineage)
end

function Lineage:record(token, parent)
    if _type(token) ~= "string" then return end
    self.epoch = self.epoch + 1
    local entry = {
        token = token, parent = parent, epoch = self.epoch,
        time = _clock(), chain = Crypto.chain(parent or "root", token),
    }
    _insert(self.generations, entry)
    self.byToken[token] = entry
    if #self.generations > self.maxNodes then
        local old = _remove(self.generations, 1)
        if old and old.token then self.byToken[old.token] = nil end
    end
end

function Lineage:descend(depth)
    depth = _min(depth or 1, self.maxDepth)
    local n = #self.generations
    if n == 0 then return Crypto.forgeToken(_tostring(_clock()), 32) end
    local current = self.generations[n].token
    local parent = current
    for i = 1, depth do
        current = Crypto.forgeToken(
            current .. "|g" .. i .. "|" .. _tostring(_clock())
            .. "|" .. Crypto.hex(Crypto.chain(parent, i))
            .. "|" .. _tostring(Entropy.int(0, 999999)), 32)
        parent = current
    end
    self:record(current, self.generations[n].token)
    return current
end

function Lineage:verifyChain(token)
    local e = self.byToken[token]; if not e then return false end
    return Crypto.chain(e.parent or "root", token) == e.chain
end

