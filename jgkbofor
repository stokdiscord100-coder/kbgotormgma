-- ========== AUTO BUY WATER ==========
local function buyWaterOnly()
    if getCount("Water") >= 1 then return end

    local maxAttempts = 20
    local attempt = 0

    while attempt < maxAttempts do
        attempt = attempt + 1

        local v1 = buffer.create(3)
        buffer.writeu8(v1, 0, 24)
        buffer.writeu8(v1, 1, NPC_ID)
        buffer.writeu8(v1, 2, 3)
        RE:FireServer(v1)

        local deadline = os.clock() + 2
        repeat task.wait(0.05)
        until getCount("Water") >= 1 or os.clock() > deadline

        if getCount("Water") >= 1 then break end
        task.wait(0.1)
    end
end

-- ========== AUTO BUY SUGAR + GELATIN ==========
local function buySugarGelatin()
    local items = {
        {index = 1, name = "Gelatin"},
        {index = 2, name = "Sugar Block Bag"}
    }

    for _, item in pairs(items) do
        if getCount(item.name) >= 1 then continue end

        local maxAttempts = 30
        local attempt = 0

        while attempt < maxAttempts do
            attempt = attempt + 1

            local v1 = buffer.create(3)
            buffer.writeu8(v1, 0, 24)
            buffer.writeu8(v1, 1, NPC_ID)
            buffer.writeu8(v1, 2, item.index)
            RE:FireServer(v1)

            local deadline = os.clock() + 2
            repeat task.wait(0.05)
            until getCount(item.name) >= 1 or os.clock() > deadline

            if getCount(item.name) >= 1 then break end
            task.wait(0.1)
        end
    end
end

