local Entropy = {}
Entropy.pool = {}
Entropy.size = 0
Entropy.maxSize = 256
Entropy.seed = _floor((_clock() * 1e6) + (_time() * 1000)) % 2147483647
Entropy.regenCount = 0

function Entropy.mix(v)
    Entropy.seed = (Entropy.seed * 1103515245 + 12345 + _floor(v or 0)) % 2147483647
    _insert(Entropy.pool, Entropy.seed)
    Entropy.size = Entropy.size + 1
    if Entropy.size > Entropy.maxSize then
        _remove(Entropy.pool, 1); Entropy.size = Entropy.size - 1
    end
    return Entropy.seed
end

function Entropy.next()
    Entropy.mix(_floor(_clock() * 1e9) % 2147483647)
    local idx = (Entropy.seed % _max(1, Entropy.size)) + 1
    local a = Entropy.pool[idx] or Entropy.seed
    local b = Entropy.pool[((idx + 7) % _max(1, Entropy.size)) + 1] or Entropy.seed
    Entropy.seed = (Entropy.seed * 1664525 + a + b) % 2147483647
    return Entropy.seed / 2147483647
end

function Entropy.int(lo, hi)
    lo = lo or 0; hi = hi or 1
    return lo + _floor(Entropy.next() * (hi - lo + 1))
end

