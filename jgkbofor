-- ===== CANARY =====
local Canary = {}

function Canary.findCanaries(fn)
    if _type(fn) ~= "function" then return {} end
    local canaries = {}
    for _, e in _ipairs(scanUpvalues(fn, "function", false)) do
        local iok, info = _pcall(_debug.getinfo, e.value)
        if iok and info then
            local n = (info.name or ""):lower()
            local src = (info.source or ""):lower()
            if n:find("canary") or n:find("guard") or n:find("trap")
                or n:find("bait") or n:find("watchdog") or n:find("monitor")
                or src:find("canary") or src:find("guard") then
                canaries[#canaries + 1] = { index = e.index, name = e.name, fn = e.value, info = info }
            end
        end
    end
    return canaries
end

local function safeCanaryCall(fn, ...)
    if _type(fn) ~= "function" then return false, "not function" end
    local co = _coroutine.create(fn)
    local args = _pack(...)
    local ok, err = _coroutine.resume(co, _unpack(args, 1, args.n))
    if not ok then return false, err end
    for _ = 1, 4 do
        if _coroutine.status(co) == "dead" then break end
        local rok, rerr = _coroutine.resume(co)
        if not rok then return false, rerr end
    end
    if _coroutine.status(co) ~= "dead" then return false, "yielded past budget" end
    return true
end

local _canarySignatures = setmetatable({}, { __mode = "k" })

function Canary.preserveCanaries(_, canaries)
    local n = 0
    for _, c in _ipairs(canaries) do
        if _type(c.fn) == "function" then safeCanaryCall(c.fn); n = n + 1 end
    end
    return n
end

function Canary.feedCanaries(_, canaries)
    local n = 0
    for _, c in _ipairs(canaries) do
        if _type(c.fn) == "function" then
            local ok, info = _pcall(_debug.getinfo, c.fn)
            local nparams = _max(1, (ok and info and info.nparams) or 0)
            local sig = _canarySignatures[c.fn]
            if sig then
                if safeCanaryCall(c.fn, _unpack(sig.args, 1, sig.n)) then n = n + 1 end
            else
                local args = {}
                for i = 1, nparams do args[i] = true end
                args[1] = (Entropy.int(1, 2) == 1)
                args[2] = Entropy.int(1, 99)
                args[3] = ({ "ok", "true", "1", "yes" })[Entropy.int(1, 4)]
                if safeCanaryCall(c.fn, _unpack(args, 1, nparams)) then
                    _canarySignatures[c.fn] = { args = args, n = nparams }
                    n = n + 1
                end
            end
        end
    end
    return n
end

function Canary.scanAll(deadlineSec)
    deadlineSec = deadlineSec or 2.5
    local deadline = _clock() + deadlineSec
    local found = {}
    local gcAll = _getgc(true)
    local n = #gcAll
    local CHUNK = 400
    for cs = 1, n, CHUNK do
        if _clock() > deadline then break end
        for i = cs, _min(cs + CHUNK - 1, n) do
            local obj = gcAll[i]
            if _type(obj) == "function" then
                local c = Canary.findCanaries(obj)
                if #c > 0 then found[#found + 1] = { fn = obj, canaries = c } end
            end
        end
        _task.wait()
    end
    return found
end

-- ===== RF HOOK =====
local function hookRemoteFunction(RF, fake)
    if not RF then return false end
    local deadline = _clock() + 5
    local hasInvoke = false
    repeat
        local ok = _pcall(function() return RF.InvokeServer end)
        if ok then hasInvoke = true; break end
        jWaitLocal(0.08, 0.03)
    until hasInvoke or _clock() > deadline
    if not hasInvoke then return false end

    local orig = RF.InvokeServer
    local slots = { {1, "T1"}, {2, "T2"}, {4, "T5"}, {6, "T3"}, {8, "T6"}, {11, "T4"} }

    local handler = function(s, ...)
        if ShutdownController.shutdown then return nil end
        if not memCheck() then return nil end
        local ok3, args = _pcall(_pack, ...)
        if ok3 and args and _type(args[1]) == "table" then
            local t = args[1]
            for _, slot in _ipairs(slots) do
                _pcall(function() if t[slot[1]] ~= nil then gv[slot[2]] = t[slot[1]] end end)
            end
        end
        local t0 = _clock()
        local rok, res = _pcall(orig, s, ...)
        local observed = (_clock() - t0) * 1000
        if args and args[1] then Timing.observeRoundTrip(_tostring(args[1]), observed) end

        if rok and res ~= nil then
            fake.realCount = fake.realCount + 1
            if args and args[1] then
                _pcall(function()
                    local seed = _tostring(args[1])
                    fake.validator:observe(seed, res)
                    fake.validator:markValid()
                end)
            end
            return res
        end

        if fake and args then
            fake.forgedCount = fake.forgedCount + 1
            fake.validator:markInvalid()
            local seed = args[1] and _tostring(args[1]) or ""
            local schemaForge = fake.validator:forgeForSchema(
                seed, Crypto.forgeServerToken(seed, fake.lastHandshake or 0))
            if schemaForge then return schemaForge end
            return fake:invoke(fake, ...)
        end
        return nil
    end

    return safeHook(RF.InvokeServer, (_newcc and _newcc(handler)) or handler)
end

-- ===== BXOR HOOK =====
local _bypassMarker = setmetatable({}, { __mode = "k" })
gv._bxorHooked = false

local function hookBxorTiming(hyphonScript)
    if not (_checkcaller and _getcalling and hyphonScript) then return false end
    if gv._bxorHooked then return true end
    local orig = _b32_bxor
    local replacement = function(a, b)
        if ShutdownController.shutdown then return orig(a, b) end
        if not _checkcaller() then
            local ok, caller = _pcall(_getcalling)
            if ok and caller == hyphonScript then
                local co = _coroutine.running()
                if co and not _bypassMarker[co] then
                    _bypassMarker[co] = true
                    local budget = Entropy.int(40, 72)
                    for _ = 1, budget do _coroutine.yield() end
                end
                return orig(a, b)
            end
        end
        return orig(a, b)
    end
    local wrapped = (_newcc and _newcc(replacement)) or replacement
    local ok = safeHook(bit32.bxor, wrapped)
    if ok then gv._bxorHooked = true end
    return ok
end

