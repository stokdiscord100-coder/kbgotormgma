-- ========== LINEAR TWEEN ==========
local function TweenPosition(hrp, targetPos, duration)
    if not hrp or not targetPos then return false end
    _G.IsCookingOrLerping = true

    local char = LP.Character
    if not char or not char.Parent then _G.IsCookingOrLerping = false return false end

    pcall(function() hrp:SetNetworkOwner(LP) end)

    local TOLERANCE = 3
    local startPos = hrp.Position
    local remaining = (startPos - targetPos).Magnitude

    if remaining <= TOLERANCE then
        _G.IsCookingOrLerping = false
        return true
    end

    local elapsed = 0
    local step = 0.05

    while elapsed < duration do
        if stopReq then _G.IsCookingOrLerping = false return false end
        elapsed = elapsed + step
        local alpha = math.min(elapsed / duration, 1)
        local newPos = startPos + (targetPos - startPos) * alpha
        pcall(function()
            char:PivotTo(CFrame.new(newPos))
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        task.wait(step)
    end

    pcall(function()
        char:PivotTo(CFrame.new(targetPos))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)

    task.wait(0.2)
    _G.IsCookingOrLerping = false
    return (hrp.Position - targetPos).Magnitude < 8
end

