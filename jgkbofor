function ValidatorMirror:forgeForSchema(seed, serverToken)
    local schema = self.observedSchemas[seed]
    if not schema then return nil end
    local forged = {}
    for k in _pairs(schema.fields) do
        local t = schema.types[k]
        if t == "string" then forged[k] = Crypto.forgeToken(serverToken .. "|" .. _tostring(k), 32)
        elseif t == "number" then forged[k] = Crypto.forgeNumeric(serverToken .. "|" .. _tostring(k))
        elseif t == "boolean" then forged[k] = (Entropy.int(1, 2) == 1)
        elseif t == "table" then forged[k] = {} end
    end
    self.lastForge = forged
    return forged
end

