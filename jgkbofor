-- ========== TELEPORT TO Y ==========
local function TeleportToY(targetY, duration)
    duration = duration or 0.3
    local char = GetCharacter()
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    _G.IsCookingOrLerping = true
    local startY = hrp.Position.Y
    local elapsed = 0
    local step = 0.05

    local connection
    local done = false

    connection = game:GetService("RunService").Heartbeat:Connect(function(dt)
        if done then connection:Disconnect() return end
        elapsed = elapsed + dt
        local alpha = math.min(elapsed / duration, 1)
        local newY = startY + (targetY - startY) * alpha
        pcall(function()
            local currentPos = hrp.Position
            char:PivotTo(CFrame.new(currentPos.X, newY, currentPos.Z))
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        if alpha >= 1 then
            done = true
            connection:Disconnect()
        end
    end)

    local timeout = os.clock() + duration + 0.5
    repeat task.wait() until done or os.clock() > timeout

    _G.IsCookingOrLerping = false
    return true
end

