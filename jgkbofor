local function isMotorPart(part, motorRoot)
    if not part or not motorRoot then return false end

    if part == motorRoot then return true end
    if motorRoot.Parent and part:IsDescendantOf(motorRoot.Parent) then return true end

    if part:IsA("Seat") or part:IsA("VehicleSeat") then return true end

    for _, weld in ipairs(part:GetChildren()) do
        if weld:IsA("Weld") or weld:IsA("WeldConstraint") or weld:IsA("Motor6D") then
            local p0 = weld.Part0
            local p1 = weld.Part1
            if p0 and (p0:IsA("Seat") or p0:IsA("VehicleSeat")) then return true end
            if p1 and (p1:IsA("Seat") or p1:IsA("VehicleSeat")) then return true end
        end
    end

    if part:FindFirstChildWhichIsA("Seat", true) then return true end

    return false
end

local function noclipAroundMotor(motorRoot, radius)
    radius = radius or 10
    if not motorRoot or not motorRoot.Parent then return end

    local char = LP.Character
    local seatPart = nil
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then seatPart = hum.SeatPart end
    end

    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {}
    if motorRoot.Parent then exclude[#exclude+1] = motorRoot.Parent end
    if char then exclude[#exclude+1] = char end
    if seatPart then
        exclude[#exclude+1] = seatPart
        if seatPart.Parent then exclude[#exclude+1] = seatPart.Parent end
    end
    params.FilterDescendantsInstances = exclude

    local ok, parts = pcall(function()
        return workspace:GetPartBoundsInBox(motorRoot.CFrame, Vector3.new(radius, radius, radius), params)
    end)
    if not ok or not parts then return end

    for _, p in ipairs(parts) do
        if p:IsA("BasePart") and p.CanCollide and not _noclipStore[p] then
            if isWallPartName(p.Name) then continue end
            if isMotorPart(p, motorRoot) then continue end

            local skip = false
            for _, w in ipairs(p:GetChildren()) do
                if w:IsA("Weld") or w:IsA("WeldConstraint") then
                    local other = (w.Part0 == p) and w.Part1 or w.Part0
                    if other and char and other:IsDescendantOf(char) then
                        skip = true
                        break
                    end
                end
            end
            if skip then continue end

            _noclipStore[p] = true
            pcall(function() p.CanCollide = false end)
        end
    end
end

local function restoreNoclip()
    for p in pairs(_noclipStore) do
        if p and p.Parent then
            pcall(function() p.CanCollide = true end)
        end
    end
    _noclipStore = {}
end

