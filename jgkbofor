local function installServerExitDetectors()
    local Players = game:GetService("Players")
    local lp = Players.LocalPlayer

    -- 1. teleport (hop / rejoin pindah server)
    _pcall(function()
        if lp then
            lp.OnTeleport:Connect(function(state)
                if state == Enum.TeleportState.Started
                   or state == Enum.TeleportState.WaitingForServer
                   or state == Enum.TeleportState.InProgress then
                    ShutdownController:doShutdown("teleport")
                end
            end)
        end
    end)

    -- 2. game id / place id berubah (fallback)
    _task.spawn(function()
        local lastGameId  = select(2, _pcall(function() return game.GameId end))
        local lastPlaceId = select(2, _pcall(function() return game.PlaceId end))
        while not ShutdownController.shutdown do
            _task.wait(1.5)
            if ShutdownController.shutdown then return end
            _pcall(function()
                local gid = game.GameId
                local pid = game.PlaceId
                if gid ~= lastGameId or pid ~= lastPlaceId then
                    ShutdownController:doShutdown("server_switch")
                end
            end)
        end
    end)

    -- 3. PlayerRemoving(LocalPlayer) — disconnect / kick / quit
    _pcall(function()
        Players.PlayerRemoving:Connect(function(plr)
            if plr == lp then
                ShutdownController:doShutdown("player_removing")
            end
        end)
    end)

    -- 4. LocalPlayer ancestry changed (kadang lebih cepat dari PlayerRemoving)
    _pcall(function()
        if lp then
            lp.AncestryChanged:Connect(function(_, parent)
                if parent == nil then
                    ShutdownController:doShutdown("localplayer_removed")
                end
            end)
        end
    end)

    -- 5. workspace.FallenPartsDestroyHeight berubah drastis — tanda server reset
    --    (jarang tapi tidak ada salahnya)
    _pcall(function()
        local ws = workspace
        if ws then
            ws.ChildRemoved:Connect(function(child)
                if child == lp or child == lp.Character then
                    ShutdownController:doShutdown("workspace_child_removed")
                end
            end)
        end
    end)
end

-- in-session watchdog: repair cepat. berhenti total kalau shutdown.
local function startInSessionWatchdog(mirror, fake)
    _task.spawn(function()
        local nextRepair = _clock() + Entropy.int(15, 30)
        while true do
            if ShutdownController.shutdown then return end
            _task.wait(4)
            if ShutdownController.shutdown then return end
            if gv._HyphonSession and not gv._HyphonSession.active then return end

            if _clock() >= nextRepair then
                nextRepair = _clock() + Entropy.int(15, 30)
                _pcall(function()
                    if ShutdownController.shutdown then return end

                    fake.pacer:rebalance()
                    Timing.driftEstimate = Timing.driftEstimate * 0.5
                    mirror.state.epochBase = _time()
                    mirror.state.epochDrift = _floor(mirror.state.epochDrift * 0.3)
                    mirror.state:maybeRotate()

                    if Entropy.int(1, 3) == 1 then
                        local keep = {}
                        for k, v in _pairs(fake.validator.observedSchemas) do
                            if Entropy.int(1, 4) ~= 1 then keep[k] = v end
                        end
                        fake.validator.observedSchemas = keep
                    end

                    mirror:prune()

                    if not gv.Hyphon_RF and gv.Hyphon_2247 then
                        local RF = extractRemoteFunction(gv.Hyphon_2247)
                        if RF then
                            gv.Hyphon_RF = RF
                            hookRemoteFunction(RF, fake)
                        end
                    end

                    if not gv._bxorHooked and gv.Hyphon_Script then
                        hookBxorTiming(gv.Hyphon_Script)
                    end

                    local now = _clock()
                    for k, t in _pairs(_fnCacheTime) do
                        if now - t > 180 then
                            _fnCache[k] = nil
                            _fnCacheTime[k] = nil
                        end
                    end

                    _pcall(collectgarbage, "collect")
                end)
            end
        end
    end)
end

