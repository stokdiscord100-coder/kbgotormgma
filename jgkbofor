    if n > self.schemaCapacity then
        local toRemove = {}
        for k in _pairs(self.observedSchemas) do _insert(toRemove, k) end
        for i = 1, _min(_floor(n * 0.3), #toRemove) do
            local idx = Entropy.int(1, #toRemove)
            self.observedSchemas[toRemove[idx]] = nil
            _remove(toRemove, idx)
