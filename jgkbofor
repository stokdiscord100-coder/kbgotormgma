local function lerpXYZ(targetPos, speed, step, forceY)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local target = targetPos
    if forceY then target = Vector3.new(targetPos.X, forceY, targetPos.Z) end

    if forceY then
        local pos = hrp.Position
        hrp.CFrame = CFrame.new(pos.X, forceY, pos.Z)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.1)
    end

    local maxTime = os.clock() + 60
    local threshold = 8

    while os.clock() < maxTime do
        local curPos = hrp.Position
        if forceY then curPos = Vector3.new(curPos.X, forceY, curPos.Z) end

        local diff = target - curPos
        local dist = diff.Magnitude

        if dist < 3 then return true end

        local move = diff.Unit * math.min(speed * step, dist)
        local newPos = curPos + move
        if forceY then newPos = Vector3.new(newPos.X, forceY, newPos.Z) end

        hrp.CFrame = CFrame.new(newPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        task.wait(step)

        local checkPos = hrp.Position
        if forceY then checkPos = Vector3.new(checkPos.X, forceY, checkPos.Z) end
        local selisih = (newPos - checkPos).Magnitude

        if selisih > threshold then
            pcall(function() hrp:SetNetworkOwner(nil) end)
            task.wait(1)
            local freezeDeadline = os.clock() + 4
            while os.clock() < freezeDeadline do
                local pinPos = hrp.Position
                if forceY then pinPos = Vector3.new(pinPos.X, forceY, pinPos.Z) end
                hrp.CFrame = CFrame.new(pinPos)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                task.wait(0.05)
                local afterPos = hrp.Position
                if forceY then afterPos = Vector3.new(afterPos.X, forceY, afterPos.Z) end
                if hrp.AssemblyLinearVelocity.Magnitude < 0.5 and (pinPos - afterPos).Magnitude < 1.5 then break end
            end
            pcall(function() hrp:SetNetworkOwner(LP) end)
            task.wait(0.1)
        end
    end

    return false
end

local function naik5Y(speed)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local startY = hrp.Position.Y
    local duration = 5 / speed
    local elapsed = 0

    local conn
    conn = game:GetService("RunService").Heartbeat:Connect(function(dt)
        if not hrp or not hrp.Parent then return end
        if elapsed >= duration then return end
        elapsed = elapsed + dt
        local alpha = math.min(elapsed / duration, 1)
        local newY = startY + (5 * alpha)
        hrp.CFrame = CFrame.new(hrp.Position.X, newY, hrp.Position.Z)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)

    task.wait(duration + 0.1)
    conn:Disconnect()

    return true
end

