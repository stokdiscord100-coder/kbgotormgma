-- ===== CRYPTO =====
local Crypto = {}

function Crypto.stableHash(str)
    local h = 5381
    str = _tostring(str)
    for i = 1, #str do h = ((h * 33) + str:byte(i)) % 2147483647 end
    return h
end

function Crypto.mixHash(seed, salt)
    local h = Crypto.stableHash(_tostring(seed) .. "|" .. _tostring(salt))
    return ((h * 1103515245) + 12345) % 2147483647
end

function Crypto.forgeToken(seed, length)
    length = length or 32
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    local out = {}
    local h = Crypto.stableHash(seed or _clock())
    for i = 1, length do
        h = Crypto.mixHash(h, i)
        out[i] = chars:sub((h % #chars) + 1, (h % #chars) + 1)
    end
    return _concat(out)
end

function Crypto.forgeNumeric(seed) return Crypto.mixHash(seed, "numeric") % 1000000 end

function Crypto.forgeServerToken(clientToken, handshakeIdx)
    local s = _tostring(clientToken) .. "|srv|" .. _tostring(handshakeIdx)
        .. "|" .. _tostring(_time()) .. "|" .. _tostring(_floor(Entropy.next() * 1e9))
    return Crypto.forgeToken(s, 32)
end

function Crypto.chain(key, msg)
    local h = Crypto.stableHash(_tostring(key) .. "||" .. _tostring(msg))
    return ((h * 1103515245) + 12345) % 2147483647
end

function Crypto.hex(n, width)
    width = width or 8
    local s = ("%x"):format(_floor(n) % (16^width))
    while #s < width do s = "0" .. s end
    return s
end

