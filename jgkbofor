local ServerState = {}
ServerState.__index = ServerState

function ServerState.new()
    return setmetatable({
        sessionId = Crypto.forgeToken("sess|" .. _tostring(_time()), 24),
        sessionBornAt = _clock(),
        sessionRotationSec = 600 + Entropy.int(0, 300),
        sessionRotations = 0,
        handshakeIdx = 0, serverEpoch = _time(), clientSeq = 0,
        varcache = {}, vars = {}, callCounter = 0, lastCallAt = 0,
        epochBase = _time(), epochDrift = 0, seqSkipBias = 0,
    }, ServerState)
end

function ServerState:get(k, d) local v = self.vars[k]; if v == nil then return d end; return v end
function ServerState:set(k, v) self.vars[k] = v end

function ServerState:bumpSeq()
    if Entropy.int(1, 9) == 1 then self.seqSkipBias = self.seqSkipBias + Entropy.int(1, 2) end
    self.clientSeq = self.clientSeq + 1 + self.seqSkipBias
    self.seqSkipBias = 0
    return self.clientSeq
end

function ServerState:nextHandshake()
    local inc = 1
    if Entropy.int(1, 5) == 1 then inc = 0 end
    if Entropy.int(1, 11) == 1 then inc = 2 end
    self.handshakeIdx = self.handshakeIdx + inc
    return self.handshakeIdx
end

function ServerState:stableVar(key, seed, len)
    if self.varcache[key] then return self.varcache[key] end
    local v = Crypto.forgeToken(_tostring(seed) .. "|" .. key, len or 16)
    self.varcache[key] = v
    return v
end

function ServerState:markCall()
    self.callCounter = self.callCounter + 1
    self.lastCallAt = _clock()
    return self.callCounter
end

function ServerState:tickEpoch()
    self.epochDrift = self.epochDrift + Entropy.int(-1, 2)
    if self.epochDrift > 5 then self.epochDrift = 5 end
    if self.epochDrift < -3 then self.epochDrift = -3 end
end

function ServerState:currentEpoch()
    return self.epochBase + (_time() - self.epochBase) + self.epochDrift
end

function ServerState:maybeRotate()
    if _clock() - self.sessionBornAt < self.sessionRotationSec then return false end
    self.sessionId = Crypto.forgeToken("sess|" .. _tostring(_time()) .. "|" .. _tostring(Entropy.int(0, 1e9)), 24)
    self.sessionBornAt = _clock()
    self.sessionRotationSec = 600 + Entropy.int(0, 300)
    self.sessionRotations = self.sessionRotations + 1
    self.varcache = {}
    return true
end

