    local function offsetSamping(pos, jarak)
        jarak = jarak or 4
        local objRef = nil
        local minDist = 5
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local d = (obj.Position - pos).Magnitude
                if d < minDist then
                    minDist = d
                    objRef = obj
                end
            end
        end

        if objRef then
            local rightVec = objRef.CFrame.RightVector
            local rx, rz = rightVec.X, rightVec.Z
            local len = math.sqrt(rx*rx + rz*rz)
            if len > 0.01 then
                rx = rx / len
                rz = rz / len
                return Vector3.new(pos.X + rx * jarak, pos.Y, pos.Z + rz * jarak)
            end
        end

        return Vector3.new(pos.X + jarak, pos.Y, pos.Z)
    end

