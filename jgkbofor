    self.responses[key] = response
    self.responseTimes[key] = _clock()
    _insert(self.handshakeHistory, { key = key, response = response })
    if #self.handshakeHistory > self.maxHistory then _remove(self.handshakeHistory, 1) end
end

function SessionMirror:getResponse(key, ttl)
    ttl = ttl or (15 + Entropy.int(0, 30))
    local r = self.responses[key]
    if not r then self.cacheMisses = self.cacheMisses + 1; return nil end
    if (_clock() - (self.responseTimes[key] or 0)) > ttl then
        self.responses[key] = nil; self.cacheMisses = self.cacheMisses + 1
        return nil
    end
    self.cacheHits = self.cacheHits + 1
    return r
end

function SessionMirror:replayWithMutation(key)
    local cached = self:getResponse(key)
    if not cached or _type(cached) ~= "table" then return nil end
    local mutated = {}
    for k, v in _pairs(cached) do
        if _type(v) == "string" and #v >= 16 then
            local prefix = v:sub(1, 8)
            local fresh = self.lineage:descend(1)
            mutated[k] = prefix .. fresh:sub(1, #v - 8)
        else mutated[k] = v end
    end
    self.replayCount = self.replayCount + 1
    return mutated
end

function SessionMirror:deriveToken(request)
    if _type(request) == "table" then
        local parts = {}
        for k, v in _pairs(request) do parts[#parts + 1] = _tostring(k) .. "=" .. _tostring(v) end
        _sort(parts)
        local tok = Crypto.forgeToken(_concat(parts, "&") .. "|" .. _tostring(Entropy.int(0, 1e9)))
        self.lastToken = tok; self.lineage:record(tok, nil); return tok
    end
    local tok = Crypto.forgeToken(_tostring(request) .. "|" .. _tostring(Entropy.int(0, 1e9)))
    self.lastToken = tok; self.lineage:record(tok, nil); return tok
end

function SessionMirror:predictNextIndex()
    if #self.patternBuffer < 3 then return nil end
    local n = #self.patternBuffer
    local a, b, c = self.patternBuffer[n-2], self.patternBuffer[n-1], self.patternBuffer[n]
    if (b - a) == (c - b) then return c + (c - b) end
    if n >= 6 then
        local p1, p2, p3 = self.patternBuffer[n-5], self.patternBuffer[n-4], self.patternBuffer[n-3]
        if p1 == a and p2 == b and p3 == c then return self.patternBuffer[n-2] end
    end
    return c + Entropy.int(1, 2)
end

function SessionMirror:pushPattern(idx)
    _insert(self.patternBuffer, idx)
    if #self.patternBuffer > 16 then _remove(self.patternBuffer, 1) end
end

function SessionMirror:prune()
    local now = _clock()
    if now - self.lastPrune < 60 then return end
    self.lastPrune = now
    for k, t in _pairs(self.responseTimes) do
        if now - t > 120 then
            self.responses[k] = nil; self.responseTimes[k] = nil; self.requests[k] = nil
        end
    end
end

-- ===== PACER =====
local Pacer = {}
Pacer.__index = Pacer

function Pacer.new(maxPerSec)
    return setmetatable({
        maxPerSec = maxPerSec or 10, window = {},
        windowSpan = 1.0, throttled = 0, allowed = 0,
        softCap = Entropy.int(maxPerSec - 3, maxPerSec),
    }, Pacer)
end

function Pacer:allow()
    local now = _clock()
    local i = 1
    while i <= #self.window do
        if now - self.window[i] > self.windowSpan then _remove(self.window, i)
        else i = i + 1 end
    end
    if #self.window >= self.softCap then self.throttled = self.throttled + 1; return false end
    _insert(self.window, now); self.allowed = self.allowed + 1
    return true
end

function Pacer:backoff()
    local occ = #self.window / _max(self.softCap, 1)
    if occ > 0.8 then return 0.05 + Entropy.int(0, 40) / 1000 end
    if occ > 0.5 then return 0.02 + Entropy.int(0, 20) / 1000 end
    return Entropy.int(0, 5) / 1000
end

function Pacer:rebalance()
    self.softCap = Entropy.int(_max(2, self.maxPerSec - 4), self.maxPerSec)
end

-- ===== HANDSHAKE =====
local Handshake = {}

function Handshake.detectIndex(request)
    if _type(request) ~= "table" then return 1 end
    if _type(request[1]) == "number" then return request[1] end
    if _type(request[1]) == "table" and _type(request[1][1]) == "number" then return request[1][1] end
    return (Crypto.stableHash(_tostring(request)) % 28) + 1
end

function Handshake.buildResponse(index, request, state)
    local token = Crypto.forgeToken(_tostring(request) .. "|hs" .. _tostring(index) .. "|" .. _tostring(Entropy.int(0, 1e9)))
    local serverToken = Crypto.forgeServerToken(token, index)
    local sessId = (state and state.sessionId) or Crypto.forgeToken("sess", 24)
    local epoch = (state and state:currentEpoch()) or _time()
    local seq = (state and state:bumpSeq()) or 0
    local callN = (state and state:markCall()) or 0
    if state and state.tickEpoch then state:tickEpoch() end

    local response = {
        [1] = serverToken, [2] = true, [3] = seq, [4] = "ok",
        [5] = { session = sessId, epoch = epoch, call = callN },
        [6] = Crypto.forgeToken(serverToken, 32),
        [7] = true,
        [8] = Crypto.forgeNumeric(serverToken),
        [9] = false, [10] = {},
        [11] = serverToken, [12] = true,
    }
    if index >= 20 then
        response[13] = _time() + Entropy.int(-2, 2)
        response[14] = Crypto.forgeToken(serverToken .. "|v2", 16)
        response[15] = Crypto.stableHash(serverToken)
        response[16] = Crypto.forgeToken(serverToken .. "|v3", 24)
        response[17] = { index = index, verified = true, session = sessId }
    end
    if index >= 25 then
        response[18] = Crypto.forgeNumeric(serverToken .. "|n2")
        response[19] = Crypto.forgeToken(serverToken .. "|v4", 40)
        response[20] = _clock()
        response[21] = {
            handshake = index, session = serverToken,
            timestamp = _time() + Entropy.int(-2, 2), valid = true,
            epoch = epoch, seq = seq, call = callN,
        }
        response[22] = Crypto.stableHash(serverToken .. "|ext")
        response[23] = true
        response[24] = "verified"
        response[25] = Crypto.forgeToken(serverToken .. "|final", 48)
        response[26] = { nested = { deep = { verified = true } } }
        response[27] = Crypto.forgeNumeric(serverToken .. "|n3")
        response[28] = serverToken
    end
    return response
end

-- ===== FAKE SERVER =====
local FakeServer = {}
FakeServer.__index = FakeServer

function FakeServer.new(mirror)
    local m = mirror or SessionMirror.new()
    local v = ValidatorMirror.new()
    return setmetatable({
        mirror = m, validator = v, reactor = Reactor.new(v, m),
        pacer = Pacer.new(12),
        callCount = 0, lastRequest = nil, lastHandshake = 0,
        forgedCount = 0, realCount = 0, replayCount = 0, fallbackCount = 0,
        lastRebalance = _clock(),
    }, FakeServer)
end

function FakeServer:makeResponse(request)
    local index = Handshake.detectIndex(request)
    self.mirror.handshakeIndex = index
    self.lastHandshake = index
    self.mirror:pushPattern(index)
    return Handshake.buildResponse(index, request, self.mirror.state)
end

function FakeServer:adaptiveForge(seed, request)
    local candidate = self.reactor:probe(seed, request)
    if candidate then return self.reactor:commit() end
    self.fallbackCount = self.fallbackCount + 1
    return self:makeResponse(request)
end

function FakeServer:invoke(self_, ...)
    if not memCheck() then return nil end
    if ShutdownController.shutdown then return nil end
    local args = _pack(...)
    local seed = ""
    if _type(args[1]) == "table" then
        local parts = {}
        for k, v in _pairs(args[1]) do parts[#parts + 1] = _tostring(k) .. "=" .. _tostring(v) end
        _sort(parts); seed = _concat(parts, ";")
    else
        for i = 1, args.n do seed = seed .. _tostring(args[i]) .. ";" end
    end

    if _clock() - self.lastRebalance > 30 then
        self.pacer:rebalance(); self.lastRebalance = _clock()
    end

    if not self.pacer:allow() then
        local backoff = self.pacer:backoff()
        if backoff > 0 then _task.wait(backoff) end
    end

    Timing.organicPause()

    local replayed = self.mirror:replayWithMutation(seed)
    if replayed then self.replayCount = self.replayCount + 1; return replayed end

    local cached = self.mirror:getResponse(seed)
    if cached then return cached end

    local t0 = _clock()
    local response = self:adaptiveForge(seed, args[1])
    local observedMs = (_clock() - t0) * 1000
    Timing.observeRoundTrip(seed, observedMs)

    self.mirror:record(seed, args[1], response)
    self.validator:observe(seed, response)
    self.lastRequest = args[1]
    self.callCount = self.callCount + 1
    self.forgedCount = self.forgedCount + 1
    return response
end

