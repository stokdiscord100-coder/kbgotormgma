    local function LerpPivotToXZ(model, targetPos, speed, stepDelay)
        local rootPart = model:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end

        local parts = {}
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") then
                table.insert(parts, {part, part.CanCollide})
                part.CanCollide = false
            end
        end

        local startPos = rootPart.Position
        local targetPosXZ = Vector3.new(targetPos.X, startPos.Y, targetPos.Z)
        local distance = (targetPosXZ - startPos).Magnitude
        if distance == 0 then return end
        local totalTime = distance / speed
        local elapsed = 0
        while elapsed < totalTime do
            local alpha = math.clamp(elapsed / totalTime, 0, 1)
            local currentPos = startPos:Lerp(targetPosXZ, alpha)
            pcall(function()
                model:PivotTo(CFrame.new(currentPos))
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
                rootPart:SetNetworkOwner(nil)
            end)
            task.wait(stepDelay)
            elapsed = elapsed + stepDelay
            local actualPos = rootPart.Position
            local drift = (Vector3.new(currentPos.X, startPos.Y, currentPos.Z) - Vector3.new(actualPos.X, startPos.Y, actualPos.Z)).Magnitude
            if drift > 8 then
                pcall(function() rootPart:SetNetworkOwner(nil) end)
                task.wait(1)
                local freezeDeadline = os.clock() + 4
                while os.clock() < freezeDeadline do
                    local pinPos = rootPart.Position
                    rootPart.CFrame = CFrame.new(pinPos)
                    rootPart.AssemblyLinearVelocity = Vector3.zero
                    rootPart.AssemblyAngularVelocity = Vector3.zero
                    task.wait(0.05)
                    local afterPos = rootPart.Position
                    if rootPart.AssemblyLinearVelocity.Magnitude < 0.5 and (pinPos - afterPos).Magnitude < 1.5 then break end
                end
                pcall(function() rootPart:SetNetworkOwner(LP) end)
                task.wait(0.1)
                startPos = Vector3.new(rootPart.Position.X, startPos.Y, rootPart.Position.Z)
                targetPosXZ = Vector3.new(targetPos.X, startPos.Y, targetPos.Z)
                distance = (targetPosXZ - startPos).Magnitude
                if distance < 3 then break end
                totalTime = distance / speed
                elapsed = 0
            end
        end
        pcall(function()
            model:PivotTo(CFrame.new(targetPosXZ))
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
        end)

        for _, data in ipairs(parts) do
            data[1].CanCollide = data[2]
        end
    end

