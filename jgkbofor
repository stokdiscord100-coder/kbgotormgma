function ValidatorMirror:observe(seed, response)
    if _type(response) ~= "table" then return end
    local schema = { fields = {}, types = {} }
    for k, v in _pairs(response) do schema.fields[k] = true; schema.types[k] = _type(v) end
    self.observedSchemas[seed] = schema
    self.fingerprint:observe(response)
    local n = 0
