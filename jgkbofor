local function cariPotBelumAktif()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = hrp and hrp.Position

    local pots = workspace.Map.Locations["The Laboratory"].Pots

    local candidates = {}

    for _, pot in ipairs(pots:GetChildren()) do
        local prompt = pot:FindFirstChild("ProximityPrompt")
        local pos = nil
        if pot:IsA("BasePart") then
            pos = pot.Position
        elseif pot:IsA("Model") and pot.PrimaryPart then
            pos = pot.PrimaryPart.Position
        else
            local bp = pot:FindFirstChildWhichIsA("BasePart", true)
            if bp then pos = bp.Position end
        end

        if not prompt or not pos then continue end

        local timerVal = 0
        for name, val in pairs(pot:GetAttributes()) do
            local n = name:lower()
            if n:find("timer") then
                if type(val) == "number" then
                    timerVal = math.max(timerVal, val)
                elseif val == true then
                    timerVal = math.max(timerVal, 1)
                end
            end
        end
        for _, v in ipairs(pot:GetDescendants()) do
            if v:IsA("NumberValue") then
                local n = v.Name:lower()
                if n:find("timer") then
                    timerVal = math.max(timerVal, v.Value)
                end
            elseif v:IsA("BoolValue") then
                local n = v.Name:lower()
                if n:find("timer") and v.Value == true then
                    timerVal = math.max(timerVal, 1)
                end
            end
        end

        if timerVal ~= 0 then continue end
        if not prompt.Enabled then continue end
        if _G.BlacklistedPots and _G.BlacklistedPots[prompt] then continue end

        local dist = myPos and (pos - myPos).Magnitude or math.huge
        table.insert(candidates, {prompt = prompt, pos = pos, dist = dist})
    end

    if #candidates == 0 then return nil, nil end

    table.sort(candidates, function(a, b) return a.dist < b.dist end)
    return candidates[1].prompt, candidates[1].pos
end

