local RE = game.ReplicatedStorage.RemoteEvents.ReliableRemoteEvent
local NPC_ID = 19

local function getCount(name)
    local c = 0
    local b = LP:FindFirstChild("Backpack")
    if b then
        for _, v in pairs(b:GetChildren()) do
            if v.Name == name then c = c + 1 end
        end
    end
    local char = GetCharacter()
    if char then
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("Tool") and v.Name == name then c = c + 1 end
        end
    end
    return c
end

local function buyIngredients(packages)
    packages = packages or 1
    if packages < 1 then packages = 1 end
    if packages > 50 then packages = 50 end

    local items = {
        {index = 1, name = "Gelatin"},
        {index = 2, name = "Sugar Block Bag"},
        {index = 3, name = "Water"}
    }

    for _, item in pairs(items) do
        if getgenv().STOP_ALL or stopReq then break end
        if getCount(item.name) >= packages then continue end

        local maxAttempts = packages * 4
        local attempt = 0

        while attempt < maxAttempts do
            if getgenv().STOP_ALL or stopReq then break end
            local current = getCount(item.name)
            if current >= packages then break end

            local v1 = buffer.create(3)
            buffer.writeu8(v1, 0, 24)
            buffer.writeu8(v1, 1, NPC_ID)
            buffer.writeu8(v1, 2, item.index)
            RE:FireServer(v1)
            attempt = attempt + 1

            local deadline = os.clock() + 2
            repeat task.wait(0.05) until getCount(item.name) > current or os.clock() > deadline
            if getCount(item.name) >= packages then break end
            task.wait(0.1)
        end
        task.wait(0.2)
    end
    return true
end

