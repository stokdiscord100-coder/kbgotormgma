-- ===== FINGERPRINT =====
local Fingerprint = {}
Fingerprint.__index = Fingerprint

local function _fp_hash(s)
    local h = 5381
    for i = 1, #s do h = ((h * 33) + s:byte(i)) % 2147483647 end
    return h
end

local function _schemaSig(tbl)
    if _type(tbl) ~= "table" then return "scalar:" .. _type(tbl) end
    local parts = {}
    for k, v in _pairs(tbl) do
        local vt = _type(v); if vt == "table" then vt = "t" end
        parts[#parts + 1] = _tostring(k) .. ":" .. vt
    end
    _sort(parts)
    return _concat(parts, ",")
end

function Fingerprint.new(maxVersions)
    return setmetatable({
        versions = {}, currentHash = nil, driftEvents = 0, totalObserved = 0,
        maxVersions = maxVersions or 8,
        lastDriftAt = 0, ttl = 90, driftRateWindow = {},
    }, Fingerprint)
end

function Fingerprint:observe(response)
    if _type(response) ~= "table" then return nil end
    self.totalObserved = self.totalObserved + 1
    local sig = _schemaSig(response)
    local hash = _fp_hash(sig)
    local now = _clock()
    if not self.versions[hash] then
        local count = 0; for _ in _pairs(self.versions) do count = count + 1 end
        if count >= self.maxVersions then
            local oh, os = nil, _huge
            for h, e in _pairs(self.versions) do
                local sc = e.count - (now - e.lastSeen) * 0.5
                if sc < os then os, oh = sc, h end
            end
            if oh then self.versions[oh] = nil end
        end
        self.versions[hash] = { schema = sig, count = 1, firstSeen = now, lastSeen = now, confidence = 1, hits = 0, misses = 0 }
    else
        local e = self.versions[hash]
        e.count = e.count + 1; e.lastSeen = now
        e.confidence = _min(1, e.confidence + 0.05)
    end
    if self.currentHash and self.currentHash ~= hash then
        self.driftEvents = self.driftEvents + 1
        self.lastDriftAt = now
        if self.versions[self.currentHash] then
            self.versions[self.currentHash].confidence = _max(0, self.versions[self.currentHash].confidence - 0.2)
        end
        self.versions[hash].confidence = _min(1, self.versions[hash].confidence + 0.3)
        _insert(self.driftRateWindow, now)
        while #self.driftRateWindow > 0 and now - self.driftRateWindow[1] > 300 do
            _remove(self.driftRateWindow, 1)
        end
        local driftRate = #self.driftRateWindow / 300
        if driftRate > 0.02 then self.ttl = _max(20, 90 - driftRate * 1000)
        else self.ttl = _min(180, 90 + (0.02 - driftRate) * 1000) end
    end
    self.currentHash = hash
    return hash
end

function Fingerprint:markHit(h) local e = self.versions[h]; if e then e.hits = e.hits + 1 end end
function Fingerprint:markMiss(h)
    local e = self.versions[h]
    if e then e.misses = e.misses + 1; e.confidence = _max(0, e.confidence - 0.15) end
end

function Fingerprint:getBest()
    local best, bh, bs = nil, nil, -1
    local now = _clock()
    for h, e in _pairs(self.versions) do
        local age = now - e.lastSeen
        local rec = 1 / (1 + age)
        local ttlPen = age > self.ttl and 0.4 or 1
        local hr = e.hits / _max(1, e.hits + e.misses)
        local sc = (e.confidence * 0.45 + hr * 0.25 + _log(e.count + 1) * 0.2 + rec * 0.1) * ttlPen
        if sc > bs then bs, bh, best = sc, h, e end
    end
    return best, bh, bs
end

-- ===== REACTOR =====
local Reactor = {}
Reactor.__index = Reactor

function Reactor.new(validator, mirror)
    return setmetatable({
        validator = validator, mirror = mirror,
        pendingSeed = nil, pendingFrg = nil,
        committed = 0, probed = 0, reverted = 0,
        windowSize = 20, recent = {}, open = false, openUntil = 0, consecutiveMiss = 0,
    }, Reactor)
end

function Reactor:_push(hit)
    _insert(self.recent, hit)
    if #self.recent > self.windowSize then _remove(self.recent, 1) end
    if hit then self.consecutiveMiss = 0 else self.consecutiveMiss = self.consecutiveMiss + 1 end
    if self.consecutiveMiss >= 6 then
        self.open = true; self.openUntil = _clock() + 2.5; self.consecutiveMiss = 0
    end
end

function Reactor:isOpen()
    if self.open and _clock() > self.openUntil then self.open = false end
    return self.open
end

function Reactor:probe(seed, _request)
    if self:isOpen() then return nil end
    self.probed = self.probed + 1
    local serverToken = Crypto.forgeServerToken(seed, (self.mirror and self.mirror.handshakeIndex) or 0)
    local specific = self.validator:forgeForSchema(seed, serverToken)
    if specific and next(specific) then
        self.pendingSeed, self.pendingFrg = seed, specific
        return specific
    end
    local best = self.validator.fingerprint:getBest()
    if best and best.confidence > 0.35 then
        local forged = {}
        for piece in best.schema:gmatch("[^,]+") do
            local key, vtype = piece:match("([^:]+):(.+)")
            if key then
                if vtype == "string" then forged[key] = Crypto.forgeToken(serverToken .. "|" .. key, 32)
                elseif vtype == "number" then forged[key] = Crypto.forgeNumeric(serverToken .. "|" .. key)
                elseif vtype == "boolean" then forged[key] = (Entropy.int(1, 2) == 1)
                elseif vtype == "t" then forged[key] = {} end
            end
        end
        if next(forged) then
            self.pendingSeed, self.pendingFrg = seed, forged
            return forged
        end
    end
    return nil
end

function Reactor:commit()
    if self.pendingFrg then
        self.committed = self.committed + 1
        self:_push(true)
        local f = self.pendingFrg
        self.pendingSeed, self.pendingFrg = nil, nil
        return f
    end
    return nil
end

function Reactor:revert(_seed)
    self.reverted = self.reverted + 1
    self:_push(false)
    self.pendingSeed, self.pendingFrg = nil, nil
    local _, h = self.validator.fingerprint:getBest()
    if h then self.validator.fingerprint:markMiss(h) end
end

