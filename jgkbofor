Timing.tailSpikeRate = 12

function Timing.measureLatency(key)
    local base = 45 + (Crypto.stableHash(_tostring(key)) % 141)
    local entropy = Entropy.int(-25, 25)
    local drift = _floor(Timing.driftEstimate)
    local t = base + entropy + drift
    if t < 20 then t = 20 end
    return t
end

function Timing.spoofDelay(key)
    local lat = Timing.measureLatency(key)
    local jitter = Entropy.int(-15, 15)
    if Entropy.int(1, Timing.tailSpikeRate) == 1 then lat = lat + Entropy.int(40, 140) end
    local delay = _max(20, lat + jitter)
    _insert(Timing.history, { t = _clock(), d = delay })
    if #Timing.history > Timing.maxHistory then _remove(Timing.history, 1) end
